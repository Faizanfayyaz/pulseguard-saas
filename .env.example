# ==========================================
# PulseGuard Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=development
APP_NAME=PulseGuard
APP_PORT=4000
DASHBOARD_PORT=3000

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_CONTAINER_PORT=3306
DB_NAME=pulseguard
DB_USER=pulseguard_user
DB_PASSWORD=pulseguard_secret_pass
DB_ROOT_PASSWORD=pulseguard_root_pass
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# Redis Configuration (BullMQ & Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD=pulseguard_redis_pass

# Security & Authentication
JWT_SECRET=pulseguard_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Next.js Dashboard Client Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

